<Project Sdk="Microsoft.NET.Sdk">

  <!-- Testes da engine de 5 trastes do YARG.Core (a mesma que roda no jogo),
       compilados contra o submódulo do fork em ../../YARG. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Resultados independentes do idioma do Windows (pt-BR usa vírgula decimal). -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>GuitarHero.EngineTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Mesmas versões usadas por YARG.Core.UnitTests. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="NUnit" Version="4.5.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\YARG\YARG.Core\YARG.Core\YARG.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Código do jogo sem dependência do Unity, testado aqui direto do fork. -->
    <Compile Include="..\..\YARG\Assets\Script\Input\Bindings\AnalogButtonHysteresis.cs" Link="Fork\AnalogButtonHysteresis.cs" />
    <Compile Include="..\..\YARG\Assets\Script\Menu\Calibrator\CalibrationMath.cs" Link="Fork\CalibrationMath.cs" />
  </ItemGroup>

</Project>
