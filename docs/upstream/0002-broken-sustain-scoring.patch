--- a/YARG.Core/Engine/BaseEngine.Generic.cs
+++ b/YARG.Core/Engine/BaseEngine.Generic.cs
@@ -1423,6 +1423,34 @@ namespace YARG.Core.Engine
             return sustain.BaseScore + deltaScore;
         }
 
+        /// <summary>
+        /// Commits the points of a sustain broken early (overstrum/overhit) the same way <see cref="UpdateSustains"/>
+        /// commits a dropped sustain: with the score multiplier and counted in SustainScore. Does nothing if the
+        /// sustain has already finished scoring (burst), so its points aren't counted twice.
+        /// </summary>
+        protected void CommitBrokenSustainPoints(ref ActiveSustain<TNoteType> sustain, uint tick)
+        {
+            if (sustain.HasFinishedScoring)
+            {
+                return;
+            }
+
+            double finalScore = CalculateSustainPoints(ref sustain, tick);
+            var points = (int) Math.Ceiling(finalScore);
+
+            AddScore(points);
+
+            // SustainPoints must include the multiplier, but NOT the star power multiplier
+            int sustainPoints = points * EngineStats.ScoreMultiplier;
+            if (EngineStats.IsStarPowerActive)
+            {
+                sustainPoints /= 2;
+            }
+
+            EngineStats.SustainScore += sustainPoints;
+            sustain.HasFinishedScoring = true;
+        }
+
         protected void AdvanceToNextNote(TNoteType note)
         {
             NoteIndex++;
