# Texto normalizado para LF no repositório
* text=auto

# Scripts do Windows precisam de CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Scripts de shell precisam de LF
*.sh text eol=lf

# Binários
*.png binary
*.jpg binary
*.ogg binary
*.mp3 binary
*.wav binary
*.flac binary
*.opus binary
